# Azure AI Foundry Configuration
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_API_KEY=your_api_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Comma-separated list of exact frontend origins allowed to call this API
# (CORS). No wildcards, no suffix/preview-URL matching. Falls back to
# http://localhost:3000,https://healthcare-claims.vercel.app if unset/blank.
ALLOWED_ORIGINS=http://localhost:3000,https://healthcare-claims.vercel.app

# Optional: Per-agent model overrides
MODEL_CLAIM_PARSER_AGENT=gpt-4o-mini
MODEL_ELIGIBILITY_AGENT=gpt-4o-mini
MODEL_ADJUDICATION_AGENT=gpt-4o
MODEL_DENIAL_REASONING_AGENT=gpt-4o
MODEL_REMITTANCE_POSTING_AGENT=gpt-4o-mini
MODEL_REVENUE_AUDIT_AGENT=gpt-4o-mini

# Demo vs Live
USE_FIXTURES=true

# Optional: Azure Storage for audit trail
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net

# Optional: Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
